# Supabase
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Direct DB connection (for migrations)
DATABASE_URL=postgres://[USER]:[PASS]@[HOST]:[PORT]/postgres

# Ingest
CRON_SECRET=replace_with_secret
X_CRON_SECRET=replace_with_secret

# KBN BTC snapshot
KBN_BTC_SNAPSHOT_ENABLED=false
KBN_BTC_SNAPSHOT_SYMBOL=BTC
KBN_BTC_SNAPSHOT_PROVIDER=coinbase_spot
KBN_BTC_SNAPSHOT_PROVIDER_SYMBOL=BTC-USD
KBN_BTC_SNAPSHOT_TARGET_CHANNEL=@Krypto_breaking
KBN_BTC_SNAPSHOT_RUN_INTERVAL_SECONDS=300
KBN_BTC_SNAPSHOT_POST_MINUTE=0
KBN_BTC_SNAPSHOT_SOURCE_URL=https://api.coinbase.com/v2/prices/BTC-USD/spot

# KBN STRC snapshot
KBN_STRC_SNAPSHOT_ENABLED=true
KBN_STRC_SNAPSHOT_SYMBOL=STRC
KBN_STRC_SNAPSHOT_PROVIDER=yahoo_chart
KBN_STRC_SNAPSHOT_PROVIDER_SYMBOL=STRC
KBN_STRC_SNAPSHOT_TARGET_CHANNEL=@Krypto_breaking
KBN_STRC_SNAPSHOT_RUN_INTERVAL_SECONDS=300
KBN_STRC_SNAPSHOT_POST_MINUTE=0
KBN_STRC_SNAPSHOT_SOURCE_URL=https://query1.finance.yahoo.com/v8/finance/chart/STRC
